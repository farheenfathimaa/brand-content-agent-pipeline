# Copy to .env and fill in only what you need.
# APP_MODE=mock needs zero API keys and uses deterministic mock providers.
APP_MODE=mock
LOG_LEVEL=INFO
DATABASE_PATH=data/pipeline.db

# ---------------------------------------------------------------------------
# Webhooks
# ---------------------------------------------------------------------------
# Every state transition is signed and POSTed when WEBHOOK_URL is set.
# Leave WEBHOOK_URL blank to record deliveries as "skipped" in SQLite.
WEBHOOK_URL=
# Set a stable random value shared with the receiver. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
WEBHOOK_SECRET=
WEBHOOK_TIMEOUT_SECONDS=5
WEBHOOK_MAX_ATTEMPTS=3
WEBHOOK_RETRY_BACKOFF_SECONDS=0.15

# ---------------------------------------------------------------------------
# Pipeline policy
# ---------------------------------------------------------------------------
MAX_REVISION_LOOPS=2
TRANSLATION_SIMILARITY_THRESHOLD=0.72
GENERATE_DESIGN_ASSETS=true
DESIGN_OUTPUT_DIR=outputs/designs

# ---------------------------------------------------------------------------
# LLM providers (only read when APP_MODE=live)
# ---------------------------------------------------------------------------
# Groq is primary; Gemini is the automatic fallback. Leave keys blank in mock mode.
GROQ_API_KEY=
GEMINI_API_KEY=
LLM_PRIMARY_MODEL=groq/llama-3.3-70b-versatile
LLM_FALLBACK_MODEL=gemini/gemini-2.0-flash
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=1200

# Optional third provider. Both values are required to activate it.
ANTHROPIC_API_KEY=
LLM_ANTHROPIC_MODEL=

# Optional prompt pins. Blank means the registry's active version.
PROMPT_DRAFT_VERSION=
PROMPT_CRITIC_VERSION=
PROMPT_TRANSLATION_VERSION=
PROMPT_JUDGE_VERSION=

# ---------------------------------------------------------------------------
# Task tracker: mock | clickup | github
# ---------------------------------------------------------------------------
TASK_TRACKER=mock
CLICKUP_API_TOKEN=
CLICKUP_LIST_ID=
CLICKUP_BASE_URL=https://api.clickup.com/api/v2
GITHUB_TOKEN=
GITHUB_REPO=owner/name
GITHUB_BASE_URL=https://api.github.com

# ---------------------------------------------------------------------------
# Design provider: local | canva
# ---------------------------------------------------------------------------
# local renders HTML -> PNG with Playwright when available, then falls back to
# Pillow. No key required.
DESIGN_PROVIDER=local

# Canva Autofill is coded against the documented API but is NOT live-tested.
# It requires Canva Enterprise and a brand template with matching fields.
CANVA_ACCESS_TOKEN=
CANVA_BRAND_TEMPLATE_ID=
CANVA_BASE_URL=https://api.canva.com/rest
